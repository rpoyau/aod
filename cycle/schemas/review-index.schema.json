{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical_review_path": {
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
      "type": "string"
    },
    "canonical_review_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "historical_reviews": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "status": {
            "const": "historical_noncanonical"
          }
        },
        "required": [
          "path",
          "sha256",
          "status"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "3.1"
    }
  },
  "required": [
    "schema_version",
    "canonical_review_path",
    "canonical_review_sha256",
    "historical_reviews"
  ],
  "title": "AOD Review Index",
  "type": "object"
}
